{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/vm-config.schema.json",
  "type": "object",
  "required": ["name", "architecture", "acceleration", "vcpus", "memory_mib"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "architecture": { "enum": ["x86_64", "i386", "ppc", "ppc64", "sparc", "sparc64", "mips", "mips64", "aarch64", "arm", "m68k", "alpha", "riscv64"] },
    "machine_type": { "type": ["string", "null"] },
    "acceleration": { "enum": ["kvm", "whpx", "hvf", "nvmm", "tcg"] },
    "vcpus": { "type": "integer", "minimum": 1 },
    "memory_mib": { "type": "integer", "minimum": 16 },
    "cpu_model": { "type": ["string", "null"] },
    "cpu_flags": { "type": "array", "items": { "type": "string" } },
    "qmp_socket": { "type": ["string", "null"] },
    "gdb": { "type": ["object", "null"], "properties": { "port": { "type": "integer", "minimum": 1, "maximum": 65535 }, "stop_at_start": { "type": "boolean" } } },
    "devices": { "type": "array", "items": { "type": "object" } }
  }
}
